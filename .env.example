# EcoPulse Environment Variables Example
# Duplicate this file as .env and fill in your actual MongoDB Atlas connection string.
# DO NOT commit your actual .env file or credentials to GitHub!

# MongoDB Atlas Connection String
# Replace <username>, <password>, and cluster address with your Atlas details:
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/ecopulse?retryWrites=true&w=majority

# Port for local development (Render automatically assigns PORT in production)
PORT=3000
